# MongoDB Atlas or self-hosted MongoDB connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/aura_institute?retryWrites=true&w=majority
MONGODB_DB=aura_institute

# Generate a long random secret for production.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public app URL, used for secure cookie settings and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional seed credentials. Change them before running the seed command.
SEED_ADMIN_EMAIL=admin@aura.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_FACULTY_EMAIL=faculty@aura.edu
SEED_FACULTY_PASSWORD=ChangeMe123!
SEED_STUDENT_EMAIL=student@aura.edu
SEED_STUDENT_PASSWORD=ChangeMe123!
